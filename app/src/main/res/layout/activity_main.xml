<?xml version="1.0" encoding="utf-8"?>
<!-- Orizzontale: le misure cambiano con la dimensione dello schermo (values-sw*dp) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="@dimen/pad">

    <!-- ALTO: marchio, stato, orologio -->
    <include layout="@layout/header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- SINISTRA: disco -->
        <FrameLayout
            android:id="@+id/discCol"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:padding="@dimen/pad">

            <com.carplayer.app.DiscView
                android:id="@+id/disc"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- CENTRO: titolo, cuore, barra, comandi, striscia miniature -->
        <LinearLayout
            android:id="@+id/centerCol"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:orientation="vertical">

        <!-- La parte alta scorre se lo schermo è basso; la striscia resta sempre in basso -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/gap"
                android:paddingEnd="@dimen/gap">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/title_sp" />

                <TextView
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/artist_sp" />

                <ImageButton
                    android:id="@+id/btnHeart"
                    android:layout_width="@dimen/heart"
                    android:layout_height="@dimen/heart"
                    android:layout_marginTop="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/ico_pad"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart" />

                <!-- Barra brano: spessa il doppio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPos"
                        android:layout_width="@dimen/time_w"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/time_sp" />

                    <SeekBar
                        android:id="@+id/seek"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/seek_h"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb"
                        android:thumbOffset="0dp"
                        android:splitTrack="false" />

                    <TextView
                        android:id="@+id/tvDur"
                        android:layout_width="@dimen/time_w"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="0:00"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/time_sp" />
                </LinearLayout>

                <!-- Comandi -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnShuffle"
                        android:layout_width="@dimen/ctl_side"
                        android:layout_height="@dimen/ctl_side"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/ico_pad"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shuffle"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="@dimen/ctl_mid"
                        android:layout_height="@dimen/ctl_mid"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/ico_pad"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="@dimen/play"
                        android:layout_height="@dimen/play"
                        android:layout_marginStart="@dimen/gap"
                        android:layout_marginEnd="@dimen/gap"
                        android:background="@drawable/bg_play"
                        android:padding="@dimen/play_pad"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:tint="@color/bg" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="@dimen/ctl_mid"
                        android:layout_height="@dimen/ctl_mid"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/ico_pad"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next"
                        android:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnRepeat"
                        android:layout_width="@dimen/ctl_side"
                        android:layout_height="@dimen/ctl_side"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/ico_pad"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_repeat"
                        android:tint="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <include layout="@layout/strip" />
        </LinearLayout>

        <!-- DESTRA: cartella / preferiti + lista brani -->
        <LinearLayout
            android:id="@+id/rightCol"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_h"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabFolder"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Cartella"
                    android:textSize="@dimen/tab_sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabFavs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="&#9829; Preferiti"
                    android:textSize="@dimen/tab_sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/tab_sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Linguetta per riportare la lista dopo averla nascosta con lo swipe -->
        <LinearLayout
            android:id="@+id/showList"
            android:layout_width="@dimen/handle_w"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
