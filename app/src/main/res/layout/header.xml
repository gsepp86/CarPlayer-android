<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superiore: marchio, stato di riproduzione con equalizzatore, orologio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_h"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/logo"
                android:layout_height="@dimen/logo"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:text="CARPLAYER"
                android:textColor="@color/accent"
                android:textSize="@dimen/brand_sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.carplayer.app.EqView
                android:id="@+id/eq"
                android:layout_width="@dimen/eq_w"
                android:layout_height="@dimen/eq_h" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="IN PAUSA"
                android:textColor="@color/gray"
                android:textSize="@dimen/status_sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/dateClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/gap"
                android:format12Hour="EEE d MMM"
                android:format24Hour="EEE d MMM"
                android:textAllCaps="true"
                android:textColor="@color/gray"
                android:textSize="@dimen/date_sp" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/clock_sp" />

            <!-- Impostazioni: tema (palette colori) e uscita audio -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/gear"
                android:layout_height="@dimen/gear"
                android:layout_marginStart="@dimen/gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF" />
</LinearLayout>
